#!/usr/bin/env python3
import json
import os
from pathlib import Path
import subprocess
import sys

home=Path.home()
override=os.environ.get('BROWSER_VIEW_EXTENSION')
candidates=[Path(override)] if override else [p for base in [home/'.local/share/code-server/extensions',home/'.vscode-server/extensions',home/'.vscode-server-insiders/extensions',home/'.vscode/extensions',home/'.vscode-insiders/extensions'] for p in base.glob('*.shared-browser-*')]
def version(path):
    try:
        data=json.loads((path/'package.json').read_text())
        return tuple(int(v) for v in data['version'].split('.')) if data['name']=='shared-browser' else ()
    except (OSError,ValueError,KeyError):return ()
candidates=[p for p in candidates if version(p) and (p/'runtime/session.py').exists()]
if not candidates:sys.exit('Install the Browser View VSIX on this Linux extension host first.')
root=max(candidates,key=version)
args=sys.argv[1:] or ['status']
if args==['--root']:print(root);sys.exit()
env=os.environ.copy()
settings=home/'.config/browser-view/settings.json'
if settings.exists():
    if settings.stat().st_uid != os.getuid():sys.exit('Browser View settings must belong to this user.')
    config=json.loads(settings.read_text())
    if config.get('allowNoSandbox') is True:env.setdefault('BROWSER_VIEW_ALLOW_NO_SANDBOX','1')
    for setting,key in {'webPort':'BROWSER_VIEW_WEB_PORT','cdpPort':'BROWSER_VIEW_CDP_PORT','display':'BROWSER_VIEW_DISPLAY','desktopWidth':'BROWSER_VIEW_WIDTH','desktopHeight':'BROWSER_VIEW_HEIGHT','stateDirectory':'BROWSER_VIEW_STATE','chromiumPath':'BROWSER_VIEW_CHROMIUM'}.items():
        if config.get(setting) not in (None, ''):env.setdefault(key,os.path.expanduser(str(config[setting])))
if args[0] in ('start','stop','status','doctor'):
    os.execvpe('python3',['python3',str(root/'runtime/session.py'),*args],env)
status=subprocess.run(['python3',str(root/'runtime/session.py'),'status'],env=env,capture_output=True,text=True,check=True)
data=json.loads(status.stdout)
if not data.get('ready'):sys.exit('Start the shared browser with browser-view start first.')
env['BROWSER_VIEW_CDP']=data['cdp']
os.execvpe('node',['node',str(root/'runtime/browser.cjs'),*args],env)
